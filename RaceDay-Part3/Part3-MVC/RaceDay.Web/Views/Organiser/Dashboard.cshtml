@model DashboardViewModel
@{
    ViewData["Title"] = "Organiser dashboard";
    var today = DateOnly.FromDateTime(DateTime.Today);
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="page-title mb-0">Organiser dashboard</h1>
    <a asp-controller="Organiser" asp-action="CreateEvent" class="btn btn-brand"><i class="bi bi-plus-lg"></i> New event</a>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4"><div class="stat-card"><div class="stat-number">@Model.TotalEvents</div><div>Events created</div></div></div>
    <div class="col-md-4"><div class="stat-card"><div class="stat-number">@Model.UpcomingEvents</div><div>Upcoming events</div></div></div>
    <div class="col-md-4"><div class="stat-card"><div class="stat-number">@Model.TotalEnrolments</div><div>Total enrolments</div></div></div>
</div>

@if (Model.Rows.Count == 0)
{
    <div class="empty-state">
        <i class="bi bi-calendar-plus"></i>
        <p>You have not created any events yet.</p>
        <a asp-controller="Organiser" asp-action="CreateEvent" class="btn btn-brand">Create your first event</a>
    </div>
}
else
{
    <div class="table-responsive card shadow-sm">
        <table class="table align-middle mb-0">
            <thead>
                <tr><th>Event</th><th>Date</th><th>Type</th><th>Enrolments</th><th>When</th></tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Rows)
                {
                    var daysAway = row.Event.EventDate.DayNumber - today.DayNumber;
                    <tr>
                        <td><a asp-controller="Organiser" asp-action="Enrolments" asp-route-eventId="@row.Event.EventId" class="fw-semibold text-decoration-none">@row.Event.EventName</a></td>
                        <td>@ViewHelpers.FormatDate(row.Event.EventDate)</td>
                        <td>@row.Event.EventType</td>
                        <td><span class="badge bg-dark">@row.Enrolments</span></td>
                        <td>
                            @if (daysAway > 0)
                            {
                                <span class="badge bg-success">In @daysAway day@(daysAway == 1 ? "" : "s")</span>
                            }
                            else if (daysAway == 0)
                            {
                                <span class="badge bg-warning text-dark">Today</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Completed</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
