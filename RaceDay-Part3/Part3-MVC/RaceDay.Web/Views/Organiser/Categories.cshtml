@model CategoriesViewModel
@{
    ViewData["Title"] = "Categories - " + Model.Event.EventName;
}
<div class="mb-3"><a asp-action="Events" class="text-decoration-none"><i class="bi bi-arrow-left"></i> All events</a></div>
<h1 class="page-title">Categories</h1>
<p class="text-muted">@Model.Event.EventName - @ViewHelpers.FormatDate(Model.Event.EventDate)</p>

<div class="row g-4">
    <div class="col-lg-7">
        @if (Model.Event.Categories.Count == 0)
        {
            <div class="empty-state"><i class="bi bi-tags"></i><p>No categories yet. Add one on the right.</p></div>
        }
        else
        {
            <div class="table-responsive card shadow-sm">
                <table class="table align-middle mb-0">
                    <thead><tr><th>Category</th><th>Distance</th><th>Fee</th><th>Limit</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var category in Model.Event.Categories)
                        {
                            <tr>
                                <td class="fw-semibold">@category.CategoryName</td>
                                <td>@(category.DistanceKm is null ? "-" : category.DistanceKm.Value.ToString("0.##") + " km")</td>
                                <td>@(category.EntryFee == 0 ? "Free" : "R" + category.EntryFee.ToString("0.00"))</td>
                                <td>@(category.MaxParticipants is null ? "-" : category.MaxParticipants.Value.ToString())</td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-1">
                                        <a asp-action="EditCategory" asp-route-eventId="@Model.Event.EventId" asp-route-id="@category.CategoryId" class="btn btn-outline-dark btn-sm">Edit</a>
                                        <form asp-action="DeleteCategory" asp-route-eventId="@Model.Event.EventId" asp-route-id="@category.CategoryId" method="post" onsubmit="return confirm('Delete this category?');">
                                            <button type="submit" class="btn btn-outline-danger btn-sm">Delete</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
    <div class="col-lg-5">
        <form asp-controller="Organiser" asp-action="AddCategory" method="post" class="card card-body shadow-sm">
            <h2 class="section-title">Add a category</h2>
            <input type="hidden" name="EventId" value="@Model.Event.EventId" />
            <div class="mb-3">
                <label for="CategoryName" class="form-label">Category name</label>
                <input id="CategoryName" name="CategoryName" class="form-control" placeholder="e.g. Under 20, Senior, 10km" required maxlength="100" />
            </div>
            <div class="mb-3">
                <label for="DistanceKm" class="form-label">Distance (km) - leave empty for age categories</label>
                <input id="DistanceKm" name="DistanceKm" type="number" step="0.01" min="0.01" max="999.99" class="form-control" />
            </div>
            <div class="mb-3">
                <label for="EntryFee" class="form-label">Entry fee (R)</label>
                <input id="EntryFee" name="EntryFee" type="number" step="0.01" min="0" value="0" class="form-control" />
            </div>
            <div class="mb-3">
                <label for="MaxParticipants" class="form-label">Maximum participants (optional)</label>
                <input id="MaxParticipants" name="MaxParticipants" type="number" min="1" class="form-control" />
            </div>
            <button type="submit" class="btn btn-brand">Add category</button>
        </form>
    </div>
</div>
