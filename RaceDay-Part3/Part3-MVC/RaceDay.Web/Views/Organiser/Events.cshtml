@model List<EventDto>
@{
    ViewData["Title"] = "Manage events";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="page-title mb-0">Manage events</h1>
    <a asp-controller="Organiser" asp-action="CreateEvent" class="btn btn-brand"><i class="bi bi-plus-lg"></i> New event</a>
</div>

@if (Model.Count == 0)
{
    <div class="empty-state">
        <i class="bi bi-calendar-plus"></i>
        <p>You have not created any events yet.</p>
    </div>
}
else
{
    <div class="table-responsive card shadow-sm">
        <table class="table align-middle mb-0">
            <thead>
                <tr><th>Event</th><th>Date</th><th>Location</th><th>Type</th><th>Distance</th><th class="text-end">Manage</th></tr>
            </thead>
            <tbody>
                @foreach (var ev in Model)
                {
                    <tr>
                        <td><a asp-controller="Events" asp-action="Details" asp-route-id="@ev.EventId" class="fw-semibold text-decoration-none">@ev.EventName</a></td>
                        <td>@ViewHelpers.FormatDate(ev.EventDate)</td>
                        <td>@ev.Location</td>
                        <td>@ev.EventType</td>
                        <td>@ev.DistanceKm.ToString("0.##") km</td>
                        <td class="text-end">
                            <div class="d-inline-flex flex-wrap gap-1 justify-content-end">
                                <a asp-action="EditEvent" asp-route-id="@ev.EventId" class="btn btn-outline-dark btn-sm">Edit</a>
                                <a asp-action="Categories" asp-route-eventId="@ev.EventId" class="btn btn-outline-dark btn-sm">Categories</a>
                                <a asp-action="Enrolments" asp-route-eventId="@ev.EventId" class="btn btn-outline-dark btn-sm">Enrolments</a>
                                <a asp-action="Results" asp-route-eventId="@ev.EventId" class="btn btn-outline-dark btn-sm">Results</a>
                                <form asp-action="DeleteEvent" asp-route-id="@ev.EventId" method="post" onsubmit="return confirm('Delete this event and all its categories, enrolments and results?');">
                                    <button type="submit" class="btn btn-outline-danger btn-sm">Delete</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
