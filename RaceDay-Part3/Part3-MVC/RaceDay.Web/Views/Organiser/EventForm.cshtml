@model EventFormViewModel
@{
    var isEdit = Model.EventId.HasValue;
    ViewData["Title"] = isEdit ? "Edit event" : "Create event";
    var existingBanner = ViewHelpers.MediaUrl(Model.ExistingBanner);
}
<div class="row justify-content-center">
    <div class="col-lg-8">
        <h1 class="page-title">@ViewData["Title"]</h1>
        <form asp-controller="Organiser" asp-action="@(isEdit ? "EditEvent" : "CreateEvent")" asp-route-id="@Model.EventId" method="post" enctype="multipart/form-data" class="card card-body shadow-sm">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <input type="hidden" asp-for="EventId" />
            <input type="hidden" asp-for="ExistingBanner" />

            <div class="mb-3">
                <label asp-for="EventName" class="form-label"></label>
                <input asp-for="EventName" class="form-control" />
                <span asp-validation-for="EventName" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" rows="4" class="form-control"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="EventDate" class="form-label"></label>
                    <input asp-for="EventDate" type="date" asp-format="{0:yyyy-MM-dd}" class="form-control" />
                    <span asp-validation-for="EventDate" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Location" class="form-label"></label>
                    <input asp-for="Location" class="form-control" />
                    <span asp-validation-for="Location" class="text-danger"></span>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="DistanceKm" class="form-label"></label>
                    <input asp-for="DistanceKm" type="number" step="0.01" class="form-control" />
                    <span asp-validation-for="DistanceKm" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="EventType" class="form-label"></label>
                    <select asp-for="EventType" asp-items="EventFormViewModel.TypeOptions" class="form-select"></select>
                    <span asp-validation-for="EventType" class="text-danger"></span>
                </div>
            </div>
            <div class="mb-3">
                <label asp-for="Banner" class="form-label"></label>
                @if (existingBanner is not null)
                {
                    <div class="mb-2"><img src="@existingBanner" class="img-fluid rounded form-banner-preview" alt="Current banner" /></div>
                }
                <input asp-for="Banner" type="file" class="form-control" accept="image/png,image/jpeg,image/webp,image/gif" />
                <div class="form-text">JPEG, PNG, WebP or GIF, up to 5 MB. @(isEdit ? "Choose a file only if you want to replace the current banner." : "")</div>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-brand">@(isEdit ? "Save changes" : "Create event")</button>
                <a asp-controller="Organiser" asp-action="Events" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
