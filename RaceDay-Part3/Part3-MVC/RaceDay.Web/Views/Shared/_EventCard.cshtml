@model EventDto
@{
    var banner = ViewHelpers.MediaUrl(Model.BannerImage);
}
<div class="card event-card h-100">
    @if (banner is not null)
    {
        <img src="@banner" class="card-img-top event-banner" alt="Banner for @Model.EventName" />
    }
    else
    {
        <div class="event-banner event-banner-placeholder"><i class="bi @ViewHelpers.TypeIcon(Model.EventType)"></i></div>
    }
    <div class="card-body d-flex flex-column">
        <span class="badge badge-type mb-2 align-self-start"><i class="bi @ViewHelpers.TypeIcon(Model.EventType)"></i> @Model.EventType</span>
        <h5 class="card-title">@Model.EventName</h5>
        <p class="text-muted small mb-1"><i class="bi bi-calendar-event"></i> @ViewHelpers.FormatDate(Model.EventDate)</p>
        <p class="text-muted small mb-1"><i class="bi bi-geo-alt"></i> @Model.Location</p>
        <p class="text-muted small mb-3"><i class="bi bi-rulers"></i> @Model.DistanceKm.ToString("0.##") km</p>
        <a asp-controller="Events" asp-action="Details" asp-route-id="@Model.EventId" class="btn btn-brand mt-auto">View details</a>
    </div>
</div>
